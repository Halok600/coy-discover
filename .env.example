# Postgres connection string (use Neon's pooled URL in production).
# Leave empty for zero-config local development: the app then runs on an
# embedded Postgres (PGlite) stored in ./.data and seeds itself.
DATABASE_URL=

# Shared secret for GET /api/cron/cleanup. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" when this variable is set.
CRON_SECRET=
